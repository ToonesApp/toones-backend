PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/toones?retryWrites=true&w=majority
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5173
# OAuth client ID from Google Cloud Console. Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Public URL of the web app. Password reset emails link to <APP_URL>/reset-password. Defaults to the first CORS_ORIGIN.
APP_URL=http://localhost:5173
# SMTP for outgoing email (e.g. Resend, SendGrid, Postmark, Gmail app password). Leave SMTP_HOST blank in development
# to print emails to the server console instead. Required when NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Toones <no-reply@toones.app>
